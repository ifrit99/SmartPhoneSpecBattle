{
  "extraKnownMarketplaces": {
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      }
    }
  },
  "enabledPlugins": {
    "pstack@cursor-plugins": true
  },
  "permissions": {
    "deny": [
      "Bash(git push master)",
      "Bash(git push master *)",
      "Bash(git push origin master)",
      "Bash(git push origin master *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push origin HEAD:master)",
      "Bash(git push origin HEAD:master *)",
      "Bash(git push * HEAD:master)",
      "Bash(git push * HEAD:master *)",
      "Bash(gh pr merge *)"
    ]
  }
}
