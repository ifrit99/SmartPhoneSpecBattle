{
  "extraKnownMarketplaces": {
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      }
    }
  },
  "enabledPlugins": {
    "pstack@cursor-plugins": true
  },
  "permissions": {
    "deny": [
      "Bash(git push master)",
      "Bash(git push master *)",
      "Bash(git push origin master)",
      "Bash(git push origin master *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push *:master*)",
      "Bash(git push * *:master*)",
      "Bash(git push origin HEAD:master)",
      "Bash(git push origin HEAD:master *)",
      "Bash(git push * HEAD:master)",
      "Bash(git push * HEAD:master *)",
      "Bash(git push * HEAD master)",
      "Bash(git push * HEAD master *)",
      "Bash(git push * refs/heads/master)",
      "Bash(git push * refs/heads/master *)",
      "Bash(git push *:refs/heads/master*)",
      "Bash(git -C * push *)",
      "Bash(git -C * push * master*)",
      "Bash(cd * && git push *)",
      "Bash(cd * && git push * master*)",
      "Bash(cd * && git push *:master*)",
      "Bash(* && git push * master)",
      "Bash(* && git push * master *)",
      "Bash(* && git push *:master*)",
      "Bash(* && git push * refs/heads/master*)",
      "Bash(gh pr merge *)",
      "Bash(gh api *merge*)",
      "Bash(gh api */merge*)"
    ]
  }
}
